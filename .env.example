# =============================================
# v2.4 LLM 配置（OpenAI 兼容协议）
# ---------------------------------------------
# 使用方法：
#   1. 复制本文件：  cp .env.example .env   (Windows: copy .env.example .env)
#   2. 把下面"在用预设"的 LLM_API_KEY 填上你自己的 key
#   3. 重启 uvicorn 即可生效
#
# .env 已在 .gitignore 里，绝不会被 commit。
# ⚠️ 千万不要把真实 key 写进 .env.example 提交到仓库！
# =============================================


# ============= 在用预设：Agnes AI（OpenAI Chat Completions 兼容）=============
# base_url 必须以 /v1 结尾；model 必须是该平台支持的模型名
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.cn/v1
LLM_MODEL_NAME=agnes-2.5-flash

# ============= Alpha 双模型（可选，优先 MiniMax，失败自动切 Agnes）=============
# 未配置 MINIMAX_* 时，旧的 LLM_* 会被视为主模型配置。
# v4.6.3 提示：discover 端到端 < 15s 的关键是「非 thinking 模式」provider。
#   - MiniMax-M2.7 走 thinking 模式 → 50s 链路
#   - Agnes-2.5-flash 无 thinking → 30-40s 链路（已实测）
#   想要 < 15s 体验：在下面填一行 AGNES_API_KEY 即可（v4.4.1 修复：只认 .env 显式键）
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M2.7
# AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.cn/v1
# AGNES_MODEL=agnes-2.5-flash
# AGNES_RPM=20
# AGNES_MAX_CONCURRENCY=1
# DISCOVER_MAX_TOKENS=2200


# ============= 其他 OpenAI 兼容预设（注释掉上面 3 行，启用对应一段即可）=============

# --- OpenAI 官方 ---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini        # 或 gpt-4o / gpt-3.5-turbo

# --- DeepSeek（国内直连，价格便宜）---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat      # 或 deepseek-reasoner

# --- 通义千问 DashScope（兼容模式）---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus          # 或 qwen-turbo / qwen-max

# --- 智谱 GLM ---
# LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL_NAME=glm-4-flash        # 或 glm-4 / glm-4-plus

# --- 月之暗面 Moonshot ---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL_NAME=moonshot-v1-8k     # 或 moonshot-v1-32k / moonshot-v1-128k


# ============= 高级 =============
# 请求超时（秒，默认 45）。API 网关慢可调到 60-90
# LLM_TIMEOUT_SECONDS=45
